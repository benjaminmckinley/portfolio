---
import Layout from "./Layout.astro";
import {type Post} from "../pages/blog/post";
import Tags from "../components/Tags.astro";
const { content, frontmatter } = Astro.props;


const post = frontmatter as Post;

function readingTime() {
    const text = 'todo get from post';
    const wpm = 225;
    const words = text.trim().split(/\s+/).length;
    const time = Math.ceil(words / wpm);
    return time;
}

---
<Layout>
    <div class="post-meta">
        <div class="post-date">{post.pubDate.toDateString()}</div>
        {readingTime} minute read
        <Tags tags={post.tags} />
    </div>

    <h1>{post.title}</h1>
        <p class="post-description">{post.description}</p>
        <img class="post-image" src={post.image.url} alt={post.image.alt} />
    <slot />
</Layout>

<style>
    .post-meta {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 16px;
    }
    
    .post-description {
        font-size: 18px;
        font-weight: 400;
        color: var(--color-text-secondary)
    }
    
    .post-author {
        display: flex;
        flex-direction: row;
        align-items: center;
        
        gap: 8px;
        
        img {
            height: 32px;
            width: 32px;
            border-radius: 100%;
        }
    }
    
    .post-image {
        width: 100%;
        border-radius: var(--rounded-border-radius);
    }
</style>