---
import { getCollection } from "astro:content";
import GridCard from "./GridCard.astro";
import {type ProjectDate} from "../pages/projects/project";

const allPosts = await getCollection("blog");

const formatDate = (d: Date) => d.toLocaleDateString('en-us', { month: "long", year: 'numeric', day: "numeric"});
---

<div id="post-list" class="grid grid-cols-1 gap-16 md:grid-cols-3">
  {
      allPosts.map(({id, data: post}) => (
      <GridCard title={post.title} description={post.description} image={
          post.image
      } date={formatDate(post.pubDate)} url={`./blog/posts/${id}`} author={post.author} />
    ))
  }
</div>