---
import headshot from "../assets/bridge-benjamin.jpeg";
import background from "../assets/background.svg";
import SocialsLinks from "./SocialsLinks.astro";
import { getCollection } from "astro:content";
import ProjectList from "./ProjectList.astro";
---

<div id="container">
  <img id="background" src={background.src} alt="" fetchpriority="high" />

  <section id="hero">
    <div>
      <h1>Hi, my name is <b>Benjamin</b> 👋🏼</h1>
      <h2>Software Engineer</h2>
      <p>
        I help build scalable enterprise software and support the Developer
        Experience.
      </p>
      <SocialsLinks />
    </div>
    <a id="headshot" href="https://maps.app.goo.gl/6Qtyq48Cp7SnVtxN9"
      ><img
        src={headshot.src}
        height="480px"
        alt="Benjamin posing on a bridge in Acadia, ME"
      /></a
    >
  </section>
  <section id="selected-projects">
    <ProjectList />
  </section>
</div>

<style>
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }

  #container {
    height: 100%;
  }

  #hero {
    display: flex;
    align-items: start;
    flex-direction: row;
    justify-content: center;
    padding: 16px;
  }

  #headshot img {
    box-shadow: var(--box-shadow-static);
  }

  h1 {
    font-size: 56px;
  }
</style>
