---
import { Project } from "../pages/projects/project";

interface Props {
  project: Project;
}

const { project, id } = Astro.props<Project>;
---

<div id="project-card">
  <a href=`projects/${id}` class="image-container"
    ><img src={project.image.url} alt={project.image.alt} /></a
  >
  <div id="info">
    <span
      >{
        project.date instanceof Date
          ? project.date.toDateString()
          : `${project.date.startDate.toDateString()} - ${project.date.startDate.toDateString()}`
      }
    </span>{project.affiliation && <span>{project.affiliation}</span>}
  </div>
  <a href=`projects/${id}`><h2>{project.title}</h2></a>
  <p id="description">{project.description}</p>
</div>

<style>
  #project-card {
    #info {
      display: flex;
      flex-direction: row;
      justify-content: space-between;

      color: var(--color-text-secondary);
    }

    img {
      width: 100%;
    }

    .image-container {
      width: 100%;
      overflow: hidden;
      display: inline-block;
      transition: transform 0.2s ease-in-out;
    }

    .image-container img {
      border-radius: var(--rounded-border-radius);
    }

    .image-container:hover {
      transform: translateY(-8px);
    }

    #description {
      color: var(--color-text-secondary);
      font-weight: lighter;
    }
  }
</style>
