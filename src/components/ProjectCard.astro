---
import { Project } from "../pages/projects/project";

interface Props {
  project: Project;
}

const { project, id } = Astro.props<Project>;
---

<div id="project-card">
  <a href=`projects/${id}`
    ><img src={project.image.url} alt={project.image.alt} /></a
  >
  <div id="info">
    <span
      >{
        project.date instanceof Date
          ? project.date.toDateString()
          : `${project.date.startDate.toDateString()} - ${project.date.startDate.toDateString()}`
      }
    </span>{project.affiliation && <span>{project.affiliation}</span>}
  </div>
  <a href=`projects/${id}`><h2>{project.title}</h2></a>
  <p>{project.description}</p>
</div>

<style>
  #project-card {
    #info {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }

    img {
      border-radius: var(--rounded-border-radius);
    }
  }

  #project-card,
  #project-card img {
    width: 360px;
  }
</style>
