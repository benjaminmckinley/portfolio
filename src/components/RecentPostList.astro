---
import { getCollection } from "astro:content";
import GridCard from "./GridCard.astro";

const allPosts = await getCollection("blog").then((posts) => {
  return posts.sort((a, b) => {
    return (
      new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
    );
  });
});

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-us", {
    month: "long",
    year: "numeric",
    day: "numeric",
  });
---

<div
  id="recent-post-list"
  class="overflow-x-auto overflow-y-visible snap-x-mandatory snap-x flex scroll-smooth gap-4 pt-8"
>
  {
    allPosts.map(({ id, data: post }) => (
      <GridCard
        title={post.title}
        description={post.shortDescription}
        image={post.image}
        date={formatDate(post.pubDate)}
        url={`./blog/posts/${id}`}
        author={post.author}
        class="flex-shrink-0 flex-grow-0 w-full md:w-1/3 snap-center"
      />
    ))
  }
</div>
