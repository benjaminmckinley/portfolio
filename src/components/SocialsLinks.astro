---
import GithubLogo from "../assets/github.svg";
import LinkedInLogo from "../assets/linkedin.svg";
import GoodreadsLogo from "../assets/goodreads.svg";
import RssLogo from "../assets/rss.svg";

const githubUrl = "https://github.com/benjaminmckinley";
const linkedInUrl = "https://www.linkedin.com/in/benjaminmckinley/";
const goodreadsUrl = "https://www.goodreads.com/user/show/161495954-benjamin";
---

<ul id="social-links">
  <li>
    <a href={githubUrl} aria-label="GitHub link" target="_blank" referrerpolicy="no-referrer"
      ><GithubLogo alt="GitHub logo" loading="lazy" /></a
    >
  </li>
  <li>
    <a href={linkedInUrl} aria-label="LinkedIn link" target="_blank" referrerpolicy="no-referrer"
      ><LinkedInLogo alt="LinkedIn logo" loading="lazy" /></a
    >
  </li>
  <li>
    <a href={goodreadsUrl} aria-label="GoodReads link" target="_blank" referrerpolicy="no-referrer"
      ><GoodreadsLogo alt="GoodReads logo" loading="lazy" /></a
    >
  </li>
  <li>
    <a href="/rss.xml" aria-label="RSS feed link"><RssLogo alt="RSS logo" loading="lazy" /></a>
  </li>
</ul>

<style>
  ul {
    list-style: none;
    display: flex;
    flex-direction: row;
    gap: 16px;
    padding: 0;
    margin: 0;
  }

  svg {
    height: 20px;
    width: 20px;

    path {
      fill: var(--color-icon);
    }
  }

  a {
    color: white;
    text-decoration: none;

    padding: 12px;

    display: inline-flex;

    background-color: var(--color-button);
    border-radius: var(--rounded-border-radius);

    &:hover {
      background-color: var(--color-highlight);
      svg path {
        fill: var(--color-icon-contrast);
      }
    }
  }
</style>
